function shownoah_text(_text_id){
	switch (_text_id)
	{
		case "bigbottom":
			Text("--------> Caleb <------- is a bigggg bottom!", "Hoots Regular");
			add_move_order();
		break;
		case "bigbottomm":
			Text("Thats so true!!! Caleb is such a big bottom!!!", "Charlie Regular");
			add_move_order();
		break;
	}
}